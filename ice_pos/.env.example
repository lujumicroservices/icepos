# Copy to .env and set your Supabase project URL and anon key.
# Para empaquetar .env solo en desarrollo, añade en pubspec.yaml bajo flutter/assets:  - .env
# En releases de producción no incluyas .env: la app pedirá URL y clave en el asistente al iniciar.
# Then run supabase_schema.sql in Supabase Dashboard > SQL Editor to create sales + sale_items tables.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
